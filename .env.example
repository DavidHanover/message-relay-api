# Used when running the api/worker directly on the host (uv run ...).
# docker-compose sets its own DATABASE_URL pointing at the `db` service.
DATABASE_URL=postgresql+psycopg://messaging:messaging@127.0.0.1:5433/messaging

EMAIL_PROVIDER=sendgrid          # sendgrid | mailgun
SMS_PROVIDER=twilio
DEFAULT_FROM_EMAIL=notifications@company.com
DEFAULT_SMS_FROM=+15550000000

MOCK_VENDORS=true
MOCK_FAILURE_RATE=0.0            # e.g. 0.3 to watch retries happen
MAX_ATTEMPTS=5
